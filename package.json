{
  "name": "foodlog-workspace",
  "version": "1.0.0",
  "description": "Root workspace for foodlog serverless application",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "server:dev": "tsx watch server/src/server.ts",
    "server:start": "tsx server/src/server.ts",
    "test:server": "vitest run --dir server/tests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:db": "vitest run --dir server/tests database"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^3.2.21",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
