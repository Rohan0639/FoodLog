# Copy to .env and fill in.

# Required. Server-side key for the food-parsing endpoint (api/parse-food.ts).
GEMINI_API_KEY=your-google-gemini-api-key

# ---------------------------------------------------------------------------
# Optional, and only for upgrading an installation that previously used Supabase.
# Put these in frontend/.env. They let the one-time importer read a returning
# user's old cloud history. Safe to omit for a fresh install; delete them once
# the migration window has passed.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_KEY=your-anon-key
