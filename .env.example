# Copy to .env and fill in.

# ---------------------------------------------------------------------------
# Python backend (backend/). Required to start the server.
# DATABASE_URL: PostgreSQL connection string, e.g. from your Supabase project
#   (Connect → Session pooler). Append ?schema=foodlog_app if that is where the
#   tables live. Keep the real value in .env only.
# JWT_SECRET: at least 32 random characters.
# GEMINI_API_KEY: Google AI Studio key, used only by the server for parsing.
# CORS_ORIGIN: the frontend origin allowed to call the API.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=foodlog_app
# JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
GEMINI_API_KEY=your-google-gemini-api-key
# CORS_ORIGIN=http://localhost:5173
# PORT=8787

# ---------------------------------------------------------------------------
# Optional, and only for upgrading an installation that previously used Supabase
# as its full backend (pre-accounts version). Put these in frontend/.env. They
# let the one-time importer read a returning user's old cloud history. Safe to
# omit for a fresh install; delete them once the migration window has passed.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional: Google Drive sync (frontend/.env).
# Client ID only — the browser token flow never uses the client secret, and a
# VITE_ variable is inlined into the public bundle, so a secret here is public.
# See docs/SYNC_SETUP.md.
# ---------------------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
